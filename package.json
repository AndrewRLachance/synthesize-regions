{
  "name": "synthesize-regions",
  "version": "0.4.0",
  "description": "Controlled TypeScript source-template replacement utility using ts-morph.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-identity": {
      "types": "./dist/templates/contractIdentity.d.ts",
      "import": "./dist/templates/contractIdentity.js"
    },
    "./capability-closure": {
      "types": "./dist/templates/capabilityClosure.d.ts",
      "import": "./dist/templates/capabilityClosure.js"
    },
    "./internal/semantic-program-owner": {
      "types": "./dist/internal/semanticProgramOwner.d.ts",
      "import": "./dist/internal/semanticProgramOwner.js"
    },
    "./contract-manifest.json": "./contract-manifest.json",
    "./schemas/replacement-map.schema.json": "./schemas/replacement-map.schema.json",
    "./schemas/artifact-set-plan.schema.json": "./schemas/artifact-set-plan.schema.json",
		"./schemas/artifact-set-compilation-result.schema.json": "./schemas/artifact-set-compilation-result.schema.json",
		"./schemas/artifact-set-graph-compilation-result.schema.json": "./schemas/artifact-set-graph-compilation-result.schema.json",
		"./schemas/artifact-set-assembly-result.schema.json": "./schemas/artifact-set-assembly-result.schema.json",
		"./schemas/artifact-set-semantic-validation-result.schema.json": "./schemas/artifact-set-semantic-validation-result.schema.json",
		"./schemas/constraint-bound-static-acceptance.schema.json": "./schemas/constraint-bound-static-acceptance.schema.json",
		"./schemas/artifact-set-static-validation-result.schema.json": "./schemas/artifact-set-static-validation-result.schema.json",
    "./schemas/supported-json-schema.schema.json": "./schemas/supported-json-schema.schema.json",
    "./schemas/template-manifest.schema.json": "./schemas/template-manifest.schema.json",
    "./schemas/synthesis-graph.schema.json": "./schemas/synthesis-graph.schema.json",
    "./schemas/template-summary.schema.json": "./schemas/template-summary.schema.json",
    "./schemas/graph-compilation-result.schema.json": "./schemas/graph-compilation-result.schema.json",
    "./schemas/graph-runner-action.schema.json": "./schemas/graph-runner-action.schema.json",
    "./schemas/graph-runner-state.schema.json": "./schemas/graph-runner-state.schema.json",
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "invariants",
    "contract-manifest.json",
    "README.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typecheck.json --noEmit",
    "schemas:generate": "node --import tsx scripts/generate-schemas.ts",
    "schemas:check": "node --import tsx scripts/generate-schemas.ts --check",
    "contracts:generate": "npm run build && node --import tsx scripts/generate-contract-snapshot.ts",
    "contracts:check": "npm run build && node --import tsx scripts/generate-contract-snapshot.ts --check",
    "contracts:check:built": "node --import tsx scripts/generate-contract-snapshot.ts --check",
    "contract-manifest:generate": "node --import tsx scripts/generate-contract-manifest.ts",
    "contract-manifest:check": "node --import tsx scripts/generate-contract-manifest.ts --check",
    "invariants:check": "node --import tsx scripts/check-invariants.ts",
    "invariants:generate": "node --import tsx scripts/check-invariants.ts --write",
    "pretest": "npm run schemas:check && npm run invariants:check",
    "test": "vitest run",
    "test:fast": "vitest run",
    "benchmark:compilation": "node --import tsx scripts/benchmark-compilation.ts",
    "test:package": "npm run schemas:check && npm run build && node --import tsx scripts/package-smoke.ts",
    "test:package:built": "node --import tsx scripts/package-smoke.ts",
    "prepack": "npm run schemas:check && npm run invariants:check && npm run contract-manifest:check && npm run build && node --import tsx scripts/generate-contract-snapshot.ts --check",
    "verify": "npm run schemas:check && npm run invariants:check && npm run contract-manifest:check && npm run typecheck && npm run test:fast && npm run build && npm run test:package:built && npm run contracts:check:built"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.51",
    "ajv": "8.20.0",
    "ts-morph": "25.0.1",
    "ts-pattern": "5.9.0",
    "type-fest": "5.8.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "effect": "3.22.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
