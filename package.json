{
  "name": "synthesize-regions",
  "version": "0.1.0",
  "description": "Controlled TypeScript source-template replacement utility using ts-morph.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/replacement-map.schema.json": "./schemas/replacement-map.schema.json",
    "./schemas/artifact-set-plan.schema.json": "./schemas/artifact-set-plan.schema.json",
		"./schemas/artifact-set-compilation-result.schema.json": "./schemas/artifact-set-compilation-result.schema.json",
		"./schemas/artifact-set-graph-compilation-result.schema.json": "./schemas/artifact-set-graph-compilation-result.schema.json",
		"./schemas/artifact-set-assembly-result.schema.json": "./schemas/artifact-set-assembly-result.schema.json",
		"./schemas/artifact-set-semantic-validation-result.schema.json": "./schemas/artifact-set-semantic-validation-result.schema.json",
		"./schemas/constraint-bound-static-acceptance.schema.json": "./schemas/constraint-bound-static-acceptance.schema.json",
		"./schemas/artifact-set-static-validation-result.schema.json": "./schemas/artifact-set-static-validation-result.schema.json",
    "./schemas/supported-json-schema.schema.json": "./schemas/supported-json-schema.schema.json",
    "./schemas/template-manifest.schema.json": "./schemas/template-manifest.schema.json",
    "./schemas/synthesis-graph.schema.json": "./schemas/synthesis-graph.schema.json",
    "./schemas/template-summary.schema.json": "./schemas/template-summary.schema.json",
    "./schemas/graph-compilation-result.schema.json": "./schemas/graph-compilation-result.schema.json",
    "./schemas/graph-runner-action.schema.json": "./schemas/graph-runner-action.schema.json",
    "./schemas/graph-runner-state.schema.json": "./schemas/graph-runner-state.schema.json",
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "README.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typecheck.json --noEmit",
    "schemas:generate": "node --import tsx scripts/generate-schemas.ts",
    "schemas:check": "node --import tsx scripts/generate-schemas.ts --check",
    "pretest": "npm run schemas:check",
    "test": "vitest run",
    "test:package": "npm run schemas:check && npm run build && node --import tsx scripts/package-smoke.ts",
    "prepack": "npm run schemas:check && npm run build",
    "verify": "npm run typecheck && npm test && npm run test:package"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.51",
    "ajv": "^8.20.0",
    "ts-morph": "^25.0.1",
    "ts-pattern": "^5.9.0",
    "type-fest": "^5.8.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
