{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synthesize-regions.dev/unresolved-value-typescript-authority.schema.json",
  "title": "synthesize-regions UnresolvedValueTypeScriptAuthority",
  "description": "Closed captured-tsconfig and project-reference authority used for hermetic unresolved-value checking.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "tsConfigFilePath",
    "authorizedProjectReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tsConfigFilePath": {
      "minLength": 1,
      "type": "string"
    },
    "authorizedProjectReferences": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    }
  }
}
