{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synthesize-regions.dev/synthesis-graph.schema.json",
  "title": "synthesize-regions SynthesisGraph",
  "description": "Structural JSON Schema for SynthesisGraph values. Template existence, port compatibility, graph cycles, literal schemas, raw-code policies, and final output validation are enforced by the synthesize-regions API.",
  "$defs": {
    "GraphRegionKind": {
      "anyOf": [
        {
          "const": "identifier",
          "type": "string"
        },
        {
          "const": "expression",
          "type": "string"
        },
        {
          "const": "expressionSuffix",
          "type": "string"
        },
        {
          "const": "statement",
          "type": "string"
        },
        {
          "const": "array",
          "type": "string"
        },
        {
          "const": "object",
          "type": "string"
        },
        {
          "const": "string",
          "type": "string"
        },
        {
          "const": "number",
          "type": "string"
        },
        {
          "const": "boolean",
          "type": "string"
        },
        {
          "const": "null",
          "type": "string"
        },
        {
          "const": "objectProperty",
          "type": "string"
        }
      ],
      "$id": "GraphRegionKind"
    },
    "GraphTypeDescriptor": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "schema": {}
      },
      "$id": "GraphTypeDescriptor"
    },
    "SynthesisInput": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal",
              "type": "string"
            },
            "value": {}
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "nodeId"
          ],
          "properties": {
            "kind": {
              "const": "ref",
              "type": "string"
            },
            "nodeId": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "rawCode",
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "fragmentCollection",
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "nodeId"
                    ],
                    "properties": {
                      "kind": {
                        "const": "ref",
                        "type": "string"
                      },
                      "nodeId": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "$ref"
                    ],
                    "properties": {
                      "$ref": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "node"
                    ],
                    "properties": {
                      "kind": {
                        "const": "inline",
                        "type": "string"
                      },
                      "node": {
                        "$ref": "SynthesisNode"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "node"
          ],
          "properties": {
            "kind": {
              "const": "inline",
              "type": "string"
            },
            "node": {
              "$ref": "SynthesisNode"
            }
          }
        }
      ],
      "$id": "SynthesisInput"
    },
    "SynthesisNode": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "templateId",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "SynthesisInput"
            }
          }
        }
      },
      "$id": "SynthesisNode"
    },
    "SynthesisGoal": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "outputKind": {
          "$ref": "GraphRegionKind"
        },
        "type": {
          "$ref": "GraphTypeDescriptor"
        },
        "schema": {}
      },
      "$id": "SynthesisGoal"
    },
    "SynthesisGraph": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "nodes",
        "finalNodeId"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "SynthesisNode"
          }
        },
        "finalNodeId": {
          "type": "string"
        },
        "goal": {
          "$ref": "SynthesisGoal"
        }
      },
      "$id": "SynthesisGraph"
    }
  },
  "$ref": "SynthesisGraph"
}
