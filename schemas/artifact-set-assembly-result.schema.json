{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synthesize-regions.dev/artifact-set-assembly-result.schema.json",
  "title": "synthesize-regions ArtifactSetAssemblyResult",
  "description": "Syntax-validated immutable target assembly result without project-wide semantic acceptance.",
  "$ref": "#/$defs/ArtifactSetAssemblyResult",
  "$defs": {
    "SynthesisFailureClassification": {
      "anyOf": [
        {
          "const": "graphRepairable",
          "type": "string"
        },
        {
          "const": "artifactFillable",
          "type": "string"
        },
        {
          "const": "templatePolicyFailure",
          "type": "string"
        },
        {
          "const": "terminalFailure",
          "type": "string"
        }
      ]
    },
    "SynthesisRepairHint": {
      "additionalProperties": true,
      "type": "object",
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ArtifactSetDiagnostic": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "origin",
        "stage",
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "origin": {
          "anyOf": [
            {
              "const": "candidate",
              "type": "string"
            },
            {
              "const": "catalog",
              "type": "string"
            },
            {
              "const": "workspace",
              "type": "string"
            },
            {
              "const": "deployment",
              "type": "string"
            },
            {
              "const": "integrity",
              "type": "string"
            },
            {
              "const": "internal",
              "type": "string"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "const": "graph",
              "type": "string"
            },
            {
              "const": "template",
              "type": "string"
            },
            {
              "const": "input",
              "type": "string"
            },
            {
              "const": "port",
              "type": "string"
            },
            {
              "const": "region",
              "type": "string"
            },
            {
              "const": "ast",
              "type": "string"
            },
            {
              "const": "type",
              "type": "string"
            },
            {
              "const": "policy",
              "type": "string"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "warning",
              "type": "string"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "inputName": {
          "type": "string"
        },
        "typeParameterName": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "expected": {},
        "actual": {},
        "repairHints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SynthesisRepairHint"
          }
        },
        "compilerCode": {
          "type": "number"
        },
        "compilerCategory": {
          "anyOf": [
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "warning",
              "type": "string"
            },
            {
              "const": "suggestion",
              "type": "string"
            },
            {
              "const": "message",
              "type": "string"
            }
          ]
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        },
        "artifactId": {
          "type": "string"
        }
      }
    },
    "ArtifactSetTextEdit": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "artifactId",
        "start",
        "end",
        "resultStart",
        "resultEnd",
        "replacement",
        "artifactHash"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "resultStart": {
          "minimum": 0,
          "type": "integer"
        },
        "resultEnd": {
          "minimum": 0,
          "type": "integer"
        },
        "replacement": {
          "type": "string"
        },
        "artifactHash": {
          "type": "string"
        }
      }
    },
    "ArtifactSetChange": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "path",
            "resultingFileHash",
            "sourceText",
            "edits"
          ],
          "properties": {
            "kind": {
              "const": "createFile",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "resultingFileHash": {
              "type": "string"
            },
            "sourceText": {
              "type": "string"
            },
            "edits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactSetTextEdit"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "path",
            "baseFileHash",
            "resultingFileHash",
            "sourceText",
            "edits"
          ],
          "properties": {
            "kind": {
              "const": "modifyFile",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "baseFileHash": {
              "type": "string"
            },
            "resultingFileHash": {
              "type": "string"
            },
            "sourceText": {
              "type": "string"
            },
            "edits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactSetTextEdit"
              }
            }
          }
        }
      ]
    },
    "ArtifactSetAssemblyResult": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "ok",
            "validation",
            "changes",
            "changeSetHash",
            "contractDigest",
            "manifestDigest",
            "workspaceSnapshotHash",
            "diagnostics"
          ],
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean"
            },
            "validation": {
              "const": "syntax",
              "type": "string"
            },
            "changes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactSetChange"
              }
            },
            "changeSetHash": {
              "type": "string"
            },
            "contractDigest": {
              "pattern": "^c6_[a-f0-9]{64}$",
              "type": "string"
            },
            "manifestDigest": {
              "pattern": "^m3_[a-f0-9]{64}$",
              "type": "string"
            },
            "workspaceSnapshotHash": {
              "pattern": "^ws2_[a-f0-9]{64}$",
              "type": "string"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactSetDiagnostic"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "ok",
            "classification",
            "changes",
            "diagnostics"
          ],
          "properties": {
            "ok": {
              "const": false,
              "type": "boolean"
            },
            "classification": {
              "$ref": "#/$defs/SynthesisFailureClassification"
            },
            "changes": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactSetDiagnostic"
              }
            }
          }
        }
      ]
    }
  }
}
