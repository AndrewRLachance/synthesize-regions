{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synthesize-regions.dev/import-reconciliation-result.schema.json",
  "title": "synthesize-regions ImportReconciliationResult",
  "description": "Pure deterministic result containing reconciled candidate source bytes and explicit authorized insertion edits.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "ok",
    "files",
    "diagnostics"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "sourceText",
          "resultingFileHash",
          "importEdits"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sourceText": {
            "type": "string"
          },
          "resultingFileHash": {
            "pattern": "^f1_[a-f0-9]{64}$",
            "type": "string"
          },
          "importEdits": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "start",
                "text",
                "requirements"
              ],
              "properties": {
                "start": {
                  "minimum": 0,
                  "type": "integer"
                },
                "text": {
                  "minLength": 1,
                  "type": "string"
                },
                "requirements": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "schemaVersion",
                      "moduleSpecifier",
                      "importKind",
                      "typeOnly"
                    ],
                    "properties": {
                      "schemaVersion": {
                        "const": 1,
                        "type": "number"
                      },
                      "moduleSpecifier": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "importKind": {
                        "anyOf": [
                          {
                            "const": "named",
                            "type": "string"
                          },
                          {
                            "const": "default",
                            "type": "string"
                          },
                          {
                            "const": "namespace",
                            "type": "string"
                          },
                          {
                            "const": "sideEffect",
                            "type": "string"
                          }
                        ]
                      },
                      "importedName": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "localName": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "typeOnly": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "const": "error",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              }
            ]
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "artifactId": {
            "minLength": 1,
            "type": "string"
          },
          "templateId": {
            "minLength": 1,
            "type": "string"
          },
          "targetId": {
            "minLength": 1,
            "type": "string"
          },
          "symbolId": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "minimum": 0,
            "type": "integer"
          },
          "end": {
            "minimum": 0,
            "type": "integer"
          },
          "expected": {},
          "actual": {}
        }
      }
    }
  }
}
