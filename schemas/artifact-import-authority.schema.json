{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synthesize-regions.dev/artifact-import-authority.schema.json",
  "title": "synthesize-regions ArtifactImportAuthority",
  "description": "Caller-owned allowlist for imports reconciled into one artifact destination.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "path",
    "allowed"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "artifactId": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "allowed": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schemaVersion",
          "moduleSpecifier",
          "importKind",
          "typeOnly"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "moduleSpecifier": {
            "minLength": 1,
            "type": "string"
          },
          "importKind": {
            "anyOf": [
              {
                "const": "named",
                "type": "string"
              },
              {
                "const": "default",
                "type": "string"
              },
              {
                "const": "namespace",
                "type": "string"
              },
              {
                "const": "sideEffect",
                "type": "string"
              }
            ]
          },
          "importedName": {
            "minLength": 1,
            "type": "string"
          },
          "localName": {
            "minLength": 1,
            "type": "string"
          },
          "typeOnly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
